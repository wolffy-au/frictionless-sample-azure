@startuml
title Sequence: GET /api/items

actor Browser as Browser
participant "loadItems()\n(app.js)" as LoadItems
participant "handleItems()" as Handler
participant "getItems()" as GetItems
participant "getPool()" as GetPool
database "Azure SQL\n(appdb)" as Sql

Browser -> LoadItems : page load
activate LoadItems

loop while the response is a retryable 503, for up to ~2 minutes
LoadItems -> Handler : GET /api/items
activate Handler

Handler -> GetItems : await getItems()
activate GetItems

GetItems -> GetPool : await getPool()
activate GetPool

alt poolPromise undefined (cold start)
  GetPool -> Sql : new ConnectionPool({connectionTimeout: 30000})\n.connect()
  alt database active
    Sql --> GetPool : connected pool
  else database auto-paused (the connection attempt triggers the resume)
    Sql --> GetPool : throw 40613 "not currently available" (ELOGIN)\nor ETIMEOUT / ESOCKET
    GetPool -> GetPool : poolPromise = undefined
    GetPool --> GetItems : rejected promise
    GetItems --> Handler : rejected promise
    Handler -> Handler : isDatabaseWakingUp(error)
    Handler --> LoadItems : 503, Retry-After: 10,\njsonBody: {error: "The database is waking up. Retrying...",\nretryable: true}
    LoadItems -> Browser : set #status to "Waking the database\n(this can take up to a minute)..."
    LoadItems -> LoadItems : wait Retry-After seconds, then retry
  end
else poolPromise cached
  GetPool -> GetPool : return cached poolPromise
end
GetPool --> GetItems : pool
deactivate GetPool

GetItems -> Sql : pool.request().batch(\n  sp_getapplock, CREATE TABLE IF missing,\n  INSERT seed IF empty, SELECT ORDER BY Id)
activate Sql

alt lock/DDL/select succeed
  Sql --> GetItems : recordset (DemoItem[])
  GetItems --> Handler : DemoItem[]
  Handler --> LoadItems : 200, jsonBody: DemoItem[]
  LoadItems -> Browser : render rows
else 40613 raised by the query
  Sql --> GetItems : throw (number 40613)
  GetItems --> Handler : rejected promise
  Handler --> LoadItems : 503, Retry-After: 10 (as above)
else other exception thrown
  Sql --> GetItems : throw (lock timeout / SQL error)
  GetItems --> Handler : rejected promise
  Handler -> Handler : context.error(\n  "Unable to load demo items...")
  Handler --> LoadItems : 500,\njsonBody: {error: "Unable to load demo items.\nCheck the API logs for details."}
  LoadItems -> Browser : show the error in #status
end
deactivate Sql
deactivate GetItems
deactivate Handler
end

opt still a retryable 503 after ~2 minutes
  LoadItems -> Browser : set #status to "Unable to load demo items.\nCheck the API logs for details."
end
deactivate LoadItems

@enduml
