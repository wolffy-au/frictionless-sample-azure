    </element>
    <element identifier="id-f0ecd6fb3b8b5bb69f24b39169314ce4" xsi:type="Artifact">
      <name>appdb</name>
      <documentation>Free-tier serverless Azure SQL database (GP_S_Gen5). Holds dbo.DemoItems, created and seeded by the API on first request.</documentation>
      <properties>
        <property propertyDefinitionRef="propid-1">
          <value>GP_S_Gen5 (free limit, auto-pause)</value>
        </property>
        <property propertyDefinitionRef="propid-2">
          <value>platform</value>
        </property>
      </properties>
    </element>
    <element identifier="id-b9118a54ded651d7b8872524243f8f51" xsi:type="ApplicationComponent">
      <name>Items API</name>
      <documentation>TypeScript Azure Functions API (api/src/functions/items.ts). The page calls /api/items; on first request it creates dbo.DemoItems and inserts three sample rows if the table is empty.</documentation>
      <properties>
        <property propertyDefinitionRef="propid-2">
          <value>platform</value>
        </property>
      </properties>
    </element>
    <element identifier="id-859316e8097157ce823a81f45e5be19b" xsi:type="ApplicationComponent">
      <name>Frontend</name>
      <documentation>Static browser app (public/index.html, public/app.js). Calls GET /api/items on page load and renders the returned DemoItem rows.</documentation>
      <properties>
        <property propertyDefinitionRef="propid-2">
          <value>platform</value>
        </property>
      </properties>
    </element>
    <element identifier="id-27cc7f943927547f96ea28fdf6f271ed" xsi:type="ApplicationInterface">
      <name>/api/items Interface</name>
      <documentation>HTTP interface exposed by the Items API component for the frontend to call.</documentation>
      <properties>
        <property propertyDefinitionRef="propid-2">
          <value>platform</value>
        </property>
      </properties>
    </element>
    <element identifier="id-9e4601a2031c58ac9b6893c386b72342" xsi:type="ApplicationProcess">
      <name>Initialize Demo Data</name>
      <documentation>First-request setup inside getItems(): sp_getapplock, CREATE TABLE dbo.DemoItems if missing, INSERT 3 seed rows if empty.</documentation>
      <properties>
        <property propertyDefinitionRef="propid-2">
          <value>platform</value>
        </property>
      </properties>
    </element>
    <element identifier="id-f9a915505004556f83d517e573efdf8e" xsi:type="ApplicationProcess">
      <name>Read Demo Items</name>
      <documentation>SELECT Id, Name, Category FROM dbo.DemoItems ORDER BY Id, run every request after initialization.</documentation>
      <properties>
        <property propertyDefinitionRef="propid-2">
          <value>platform</value>
        </property>
      </properties>
    </element>
    <element identifier="id-032efff5924e5ef3b57593ad5595b7df" xsi:type="DataObject">
